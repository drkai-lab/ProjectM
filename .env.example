PW_ENV=development
PW_SECRET_KEY=change-me-generate-with-secrets-token_urlsafe-48
# ProjectM: root ユーザー(スーパーユーザーより上位)。設定すると初回起動時に作成される。
PW_ROOT_EMAIL=root@example.com
PW_ROOT_PASSWORD=change-me
PW_SUPERUSER_EMAIL=admin@example.com
PW_SUPERUSER_PASSWORD=change-me
PW_TZ=Asia/Kuala_Lumpur
# 本番: https://pm.vorlors.com (DNS設定は DNS.md を参照)
PW_PUBLIC_URL=http://localhost:8000
# 本番では 1 にする
PW_COOKIE_SECURE=0
# Telegram通知(秘密値は記載しない)
PW_TELEGRAM_TOKEN=
PW_TELEGRAM_CHAT_ID=
PW_NOTIFY_LANG=zh
RESEND_API_KEY=
PW_MAIL_FROM=ProjectM <onboarding@resend.dev>
# 検索エンジンモード: BraveSearch APIキー (https://brave.com/search/api/ で取得。未設定時はDuckDuckGoのみ)
BRAVE_SEARCH_API_KEY=
